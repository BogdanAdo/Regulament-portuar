{
  "name": "verificator-regulament-portuar",
  "version": "1.0.0",
  "description": "Verifică manevrele navelor (pilotaj, remorcaj, zi/noapte, vânt, dană) față de Regulamentul Portuar CN APM Constanța, ediția 2025.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/rules.test.js",
    "start": "node -e \"require('http').createServer((q,r)=>{const f=require('fs'),p=require('path');let u=q.url.split('?')[0];if(u==='/')u='/index.html';const fp=p.join(__dirname,u);if(!fp.startsWith(__dirname)||!f.existsSync(fp)){r.writeHead(404);return r.end('404')}const t={'.html':'text/html;charset=utf-8','.js':'text/javascript;charset=utf-8','.css':'text/css;charset=utf-8'}[p.extname(fp)]||'application/octet-stream';r.writeHead(200,{'Content-Type':t});f.createReadStream(fp).pipe(r)}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "engines": { "node": ">=18" }
}
